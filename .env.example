# ============================================================
# EPI Supervisor Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control!
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Project ref for CLI operations (from the URL above)
SUPABASE_PROJECT_REF=your-project-ref

# ─── Gemini AI (Optional) ───────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Sentry Monitoring (Optional) ────────────────────────────
# Get from: https://sentry.io → Create Project → Flutter
SENTRY_DSN=

# ─── App Configuration ────────────────────────────────────────
APP_ENV=production
APP_NAME=EPI Supervisor
APP_NAME_AR=منصة مشرف EPI

# ─── Admin User ─────────────────────────────────────────────
# The admin user should already exist in Supabase Auth
# If not, use the create-admin Edge Function to create it
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=مدير النظام

# ─── CORS (Edge Functions) ────────────────────────────────────
# ⚠️ REQUIRED for Web — Edge Functions will BLOCK browser requests without this!
# Add ALL domains that access Edge Functions:
# - Admin web panel URL
# - Flutter web URL (if deploying Flutter web)
# - Local development URLs
#
# Set this in: Supabase Dashboard → Edge Functions → Secrets
# Example:
#   ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# ─── Encryption ───────────────────────────────────────────────
# Used for local Hive storage encryption
# ⚠️ MUST be at least 32 characters — NEVER use the default in production!
# Generate a random key: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── Build ────────────────────────────────────────────────────
FLUTTER_BUILD_MODE=release

# ═══ AI v2 Configuration ═══
# HuggingFace API Token (optional but recommended)
# Get free token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_token_here

# MiMo / Gemini API Key (for chat LLM)
MIMO_API_KEY=your_mimo_key_here

# ═══ AI Providers ═══
# Groq — Ultra-fast LLM (recommended primary)
# Get free key at: https://console.groq.com/keys
# Models used: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-120b
GROQ_API_KEY=gsk_your_groq_key_here

# NVIDIA — High-quality fallback (paid)
# Get key at: https://build.nvidia.com/ → Account → API Keys
# Models used: meta/llama-3.3-70b-instruct, deepseek-ai/deepseek-r1
# Used as Tier 3 fallback in the hybrid gateway when Groq + Pollinations fail.
NVIDIA_API_KEY=nvidia_your_key_here

# OpenRouter — DeepSeek fallback (paid, last resort)
# Get key at: https://openrouter.ai/keys
# Model used: deepseek/deepseek-chat
# Used as Tier 5 last-resort fallback in the hybrid gateway.
# Set HTTP-Referer to your deployment URL for ranking credit.
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# ─── AI Provider Notes ────────────────────────────────────
# The hybrid gateway fallback chain is:
#   Tier 1: Groq (FREE, supports tool calling) — PRIMARY
#   Tier 2: Pollinations (FREE, no key needed) — FALLBACK
#   Tier 3: NVIDIA (paid, powerful) — FALLBACK
#   Tier 4: HuggingFace (FREE, open-source) — FALLBACK
#   Tier 5: OpenRouter (paid, DeepSeek) — LAST RESORT
#
# Only Groq is required for basic chat. Other providers add redundancy.
# Pollinations needs no key and is tried automatically when configured.

