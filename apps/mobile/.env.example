# ============================================================
# EPI Supervisor — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Compile-time --dart-define flags override .env values.
# ============================================================

# ─── Supabase (required) ─────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── AI (optional) ──────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key

# ─── Monitoring (optional) ──────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/yyy

# ─── Security (REQUIRED — app will crash without it) ────────
# ⚠️ MUST be at least 32 characters. Without it, local Hive storage
# cannot be encrypted and the app will throw StateError on first use.
# Generate: openssl rand -base64 32
# Then pass at build time: --dart-define=ENCRYPTION_KEY=<your-key>
ENCRYPTION_KEY=your-32-char-minimum-encryption-key-here

# ─── Offline mode (optional) ────────────────────────────────
# OFFLINE_MODE=false
