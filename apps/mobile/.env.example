# ============================================================
# EPI Supervisor — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Compile-time --dart-define flags override .env values.
# ============================================================

# ─── Supabase (required) ─────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── AI Providers (optional — used for AI chat features) ─────
# HuggingFace API Token — for embeddings and fallback LLM
# Get free token: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Z AI (GLM-4) — for AI chat with Arabic support
ZAI_API_KEY=

# OpenRouter (DeepSeek) — for AI chat fallback
OPENROUTER_API_KEY=

# Groq — ultra-fast LLM (recommended primary)
GROQ_API_KEY=

# MiMo — alternative LLM provider
MIMO_API_KEY=

# ─── Monitoring (optional) ────────────────────────────────────
# Sentry DSN for crash reporting
# Get from: https://sentry.io → Create Project → Flutter
# SENTRY_DSN=https://xxx@sentry.io/yyy

# ─── Security (REQUIRED — app will crash without it) ────────
# ⚠️ MUST be at least 32 characters. Without it, local Hive storage
# cannot be encrypted and the app will throw StateError on first use.
# Generate: openssl rand -base64 32
# Then pass at build time: --dart-define=ENCRYPTION_KEY=<your-key>
ENCRYPTION_KEY=<REPLACE_WITH_32_CHAR_MINIMUM_KEY>

# ─── Offline mode (optional) ────────────────────────────────
# Set to true to skip Supabase initialization (testing only)
# OFFLINE_MODE=false
